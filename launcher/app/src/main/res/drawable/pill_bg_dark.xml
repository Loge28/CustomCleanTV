<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF1E2022" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#59204060" />
            <stroke android:width="1.5dp" android:color="#FF336699" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2B000000" android:endColor="#14000000" />
            <stroke android:width="1.2dp" android:color="#40000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
